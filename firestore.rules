rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isChatMember(chatId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // ── Users ─────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
            'uid', 'displayName', 'email', 'createdAt'
          ]);

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    // ── Chats ─────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.members;

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.keys().hasAll([
            'type', 'members', 'memberInfo', 'createdAt'
          ]);

      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.members;

      allow delete: if false;

      // ── Messages (subcollection of chats) ───────────
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && isChatMember(chatId);

        allow create: if isAuthenticated()
          && isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasAll([
              'senderId', 'text', 'type', 'sentAt'
            ]);

        allow update: if isAuthenticated()
            && isChatMember(chatId)
            && (
                // Delete for everyone — sender only
                (resource.data.senderId == request.auth.uid
                && request.resource.data.isDeleted == true
                && request.resource.data.text == '')
                ||
                // Delete for me — anyone in the chat
                (request.auth.uid in request.resource.data.get('deletedFor', [])
                && request.resource.data.get('deletedFor', []).hasAll(
                        resource.data.get('deletedFor', [])
                    )
                && request.resource.data.get('deletedFor', []).size() 
                        == resource.data.get('deletedFor', []).size() + 1)
            );
            
        allow delete: if false;
      }
    }
   
    // ── Stories ───────────────────────────────────────
    match /stories/{storyId} {
        allow create: if isAuthenticated()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.visibleTo is list
            && request.auth.uid in request.resource.data.visibleTo;
            
        allow read: if isAuthenticated()
            && (
                resource.data.authorUid == request.auth.uid ||
                request.auth.uid in resource.data.visibleTo
            );

        allow update: if isAuthenticated()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid;

        allow delete: if isAuthenticated()
            && resource.data.authorUid == request.auth.uid;

        match /views/{viewerUid} {
            allow create, update: if isAuthenticated()
                && viewerUid == request.auth.uid;

            allow read: if isAuthenticated()
                && (
                    viewerUid == request.auth.uid ||
                    get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid
                );

            allow delete: if false;
        }
    }
  }
}
